{
  "name": "elyerr/elymod-lab",
  "type": "project",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "ElymodLab\\App\\": "app/",
      "ElymodLab\\Database\\Factories\\": "database/factories/",
      "ElymodLab\\Database\\Seeders\\": "database/seeders/",
      "ElymodLab\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ElymodLab\\App\\Providers\\ServiceProvider"
      ]
    }
  },
  "require-dev": {
    "elyerr/laravel-runtime": "^1.1",
    "elyerr/api-response": "^1.0",
    "laravel/framework": "^12.44"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
